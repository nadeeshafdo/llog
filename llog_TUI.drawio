  <diagram name="5 Save and errors" id="save-page">
    <mxGraphModel dx="1479" dy="979" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="s5-title" parent="1" style="text;html=1;whiteSpace=wrap;align=left;fontSize=16;fontStyle=1;" value="Screen 5: Save, verify, refusals - backup-first, fingerprint-checked, lock-guarded" vertex="1">
          <mxGeometry x="70" y="20" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="s5-a-label" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=12;" value="A. Save new entry (Ctrl+S, exit 0)" vertex="1">
          <mxGeometry x="70" y="60" width="740" height="34" as="geometry" />
        </mxCell>
        <mxCell id="s5-a-body" parent="1" style="text;html=1;whiteSpace=wrap;align=left;fontSize=12;fontColor=#333333;fontFamily=Courier New;" value="1. backup LOG.TXT to llog-backups/LOG.TXT.&amp;lt;timestamp&amp;gt;.bak (hash-verified)&lt;br&gt;2. append + fsync + re-read: old bytes unchanged, new entry present&lt;br&gt;3. print: saved to .../LOG.TXT (backup: ...)" vertex="1">
          <mxGeometry x="90" y="100" width="700" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s5-b-label" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=12;" value="B. Save edit (Ctrl+S in edit mode, exit 0)" vertex="1">
          <mxGeometry x="70" y="190" width="740" height="34" as="geometry" />
        </mxCell>
        <mxCell id="s5-b-body" parent="1" style="text;html=1;whiteSpace=wrap;align=left;fontSize=12;fontColor=#333333;fontFamily=Courier New;" value="1. backup first (same as A)&lt;br&gt;2. atomic rewrite: temp file + fsync + rename + dir fsync&lt;br&gt;3. verify: entry count same, every other entry byte-identical&lt;br&gt;4. print: edited 2026/05/03.. (backup: ...)" vertex="1">
          <mxGeometry x="90" y="230" width="700" height="92" as="geometry" />
        </mxCell>
        <mxCell id="s5-c-label" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=13;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=12;" value="C. Refusals (nothing written)" vertex="1">
          <mxGeometry x="70" y="342" width="740" height="34" as="geometry" />
        </mxCell>
        <mxCell id="s5-c-body" parent="1" style="text;html=1;whiteSpace=wrap;align=left;fontSize=12;fontColor=#333333;fontFamily=Courier New;" value="card not mounted: cannot read log (is the card mounted?)&lt;br&gt;empty file: refusing to write&lt;br&gt;fingerprint changed: edited elsewhere, refusing (append and edit)&lt;br&gt;empty entry or empty edit: nothing written / cancelled&lt;br&gt;identical edit text: no changes, nothing written&lt;br&gt;concurrent writers: LOG.TXT.lock held (flock) for whole read-modify-write" vertex="1">
          <mxGeometry x="90" y="382" width="700" height="140" as="geometry" />
        </mxCell>
        <mxCell id="s5-n1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;align=left;verticalAlign=top;spacing=8;" value="Bubble Tea mapping: these are not interactive screens. The update function returns a save command on Ctrl+S; the result (or refusal) prints after the alt screen exits. Keep all file I/O in store.go, never in the view layer." vertex="1">
          <mxGeometry x="70" y="542" width="740" height="90" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
